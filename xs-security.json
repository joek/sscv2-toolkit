{
  "xsappname": "mashup-debugger",
  "tenant-mode": "dedicated",
  "scopes": [
    { "name": "$XSAPPNAME.Debugger", "description": "Use the mashup debugger (view own JWT, call destinations)" }
  ],
  "role-templates": [
    { "name": "Debugger", "description": "Mashup debugger user", "scope-references": ["$XSAPPNAME.Debugger"] }
  ],
  "role-collections": [
    {
      "name": "MashupDebugger",
      "description": "Access to the mashup debugger",
      "role-template-references": ["$XSAPPNAME.Debugger"]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": ["https://*.hana.ondemand.com/**", "http://localhost:*/**"]
  }
}
